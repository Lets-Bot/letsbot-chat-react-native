# Public App Key from LetsBot panel → Channels → In-App Chat (safe to ship).
EXPO_PUBLIC_LETSBOT_APP_KEY=YOUR_APP_KEY
# Optional: your backend endpoint that returns { "token": "<identity JWT>" } for the logged-in user.
# Never put the Identity Secret in the app.
EXPO_PUBLIC_IDENTITY_ENDPOINT=https://api.example.com/letsbot/identity-token
